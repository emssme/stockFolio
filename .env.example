# docker-compose용 환경변수 템플릿
# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 .gitignore에 의해 커밋되지 않습니다.
#   cp .env.example .env

# MariaDB root 비밀번호
DB_PASSWORD=change-me

# JWT 서명 시크릿 (Base64 인코딩된 HMAC 키)
# 생성 예: openssl rand -base64 32
JWT_SECRET=change-me

# 한국투자증권 Open API (https://apiportal.koreainvestment.com 에서 발급)
KIS_APP_KEY=change-me
KIS_APP_SECRET=change-me
KIS_BASE_URL=https://openapi.koreainvestment.com:9443

# CORS 허용 Origin - 프론트엔드에 접속할 때 쓰는 주소와 동일해야 함
ALLOWED_ORIGIN=http://<EC2_PUBLIC_IP>

# 프론트엔드 빌드에 주입되는 API/WebSocket 주소
# nginx가 80번 포트에서 /api, /ws-native를 백엔드로 프록시하므로 포트 번호 없이 IP만 사용
PUBLIC_URL=http://<EC2_PUBLIC_IP>
PUBLIC_WS_URL=ws://<EC2_PUBLIC_IP>/ws-native
